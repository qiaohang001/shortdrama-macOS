{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "烬序・影墟",
  "version": "0.3.0",
  "identifier": "com.dual.shortdrama",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "echo noop",
    "beforeBuildCommand": "echo noop"
  },
  "app": {
    "windows": [
      {
        "title": "烬序・影墟",
        "url": "index.html",
        "width": 1366,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ffmpeg.exe": "ffmpeg.exe",
      "resources/director3d-desktop.exe": "director3d-desktop.exe"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  }
}
